{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"python.analysis.typeCheckingMode": "standard"
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Python:Current file",
				"type": "debugpy",
				"request": "launch",
				"program": "${file}",
				"cwd": "${fileDirname}",
				"console": "integratedTerminal",
				"env": {
					"PYTHONIOENCODING": "utf-8"
				},
				"justMyCode": false
			},			
		]
	}
}