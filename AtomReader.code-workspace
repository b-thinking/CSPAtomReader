{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "../doc"
		}
	],
	"settings": {
		"python.analysis.typeCheckingMode": "standard"
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Python:Current file",
				"type": "debugpy",
				"request": "launch",
				"program": "${file}",
				"cwd": "${fileDirname}",
				// "console": "externalTerminal",
				"console": "integratedTerminal",
				"justMyCode": true,
				"subProcess": false,
				// "logToFile": true,
				// "env": {
				// 	"DEBUGPY_LOG_DIR": "/tmp/debugpy-logs"
				// }
			},			
		]
	}
}